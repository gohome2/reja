<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/main.css" />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
      rel="stylesheet"
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400&display=swap"
      rel="stylesheet"
    />

    <script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
    <title>Portfolio</title>
  </head>

  <body>
    <div class="frame">
      <div class="main_frame">
        <div class="left_frame">
          <div class="left_1">
            <div class="left_1_1">
              <img
                src="images/Profile.png"
                width="142px"
                height="142px"
                alt=""
              />
            </div>
            <div class="left_1_2"><%=user.name%></div>
            <div class="left_1_3"><%=user.profession%></div>
            <div class="left_icons">
              <a href="">
                <img src="menu_icon/Facebook.svg" alt="" />
              </a>
              <a href="">
                <img src="menu_icon/Instagram.svg" alt="" />
              </a>
              <a href="">
                <img src="menu_icon/Twitter.svg" alt="" />
              </a>
              <a href="">
                <img src="menu_icon/Instagram.svg" alt="" />
              </a>
              <a href="">
                <img src="menu_icon/Instagram.svg" alt="" />
              </a>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_2">
            <div class="continer">
              <div class="row">
                <p>Age:</p>
                <span>24</span>
              </div>
              <div class="row">
                <p>Residence:</p>
                <span>BD</span>
              </div>
              <div class="row">
                <p>Freelance:</p>
                <span>Available</span>
              </div>
              <div class="row">
                <p>Address:</p>
                <span>Dhaka,Bangladesh</span>
              </div>
            </div>
          </div>
          <div class="marginer"></div>

          <div class="left_percent">
            <span>Languages</span>
            <div class="container">
              <div class="infoline">
                <div class="text_info">
                  <p>Bangla</p>
                  <p>100%</p>
                </div>
                <div class="line">
                  <div class="inside_line1"></div>
                </div>
              </div>
              <div class="infoline">
                <div class="text_info">
                  <p>English</p>
                  <p>80%</p>
                </div>
                <div class="line">
                  <div class="inside_line2"></div>
                </div>
              </div>
              <div class="infoline">
                <div class="text_info">
                  <p>Spanish</p>
                  <p>60%</p>
                </div>
                <div class="line">
                  <div class="inside_line3"></div>
                </div>
              </div>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_percent">
            <span>Skills</span>
            <div class="container">
              <div class="infoline">
                <div class="text_info">
                  <p>HTML</p>
                  <p>100%</p>
                </div>
                <div class="line">
                  <div class="inside_line1"></div>
                </div>
              </div>
              <div class="infoline">
                <div class="text_info">
                  <p>CSS</p>
                  <p>80%</p>
                </div>
                <div class="line">
                  <div class="inside_line2"></div>
                </div>
              </div>
              <div class="infoline">
                <div class="text_info">
                  <p>Js</p>
                  <p>60%</p>
                </div>
                <div class="line">
                  <div class="inside_line3"></div>
                </div>
              </div>
              <div class="infoline">
                <div class="text_info">
                  <p>PHP</p>
                  <p>60%</p>
                </div>
                <div class="line">
                  <div class="inside_line3"></div>
                </div>
              </div>
              <div class="infoline">
                <div class="text_info">
                  <p>WordPress</p>
                  <p>60%</p>
                </div>
                <div class="line">
                  <div class="inside_line3"></div>
                </div>
              </div>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_5">
            <span>Extra Skills</span>
            <p>Bootstrap, Materialize</p>
            <p>Stylus, Sass, Less</p>
            <p>Gulp, Webpack, Grunt</p>
            <p>GIT Knowledge</p>
          </div>
          <div class="marginer"></div>
        </div>
        <div class="midd_frame">
          <dev
            class="mid_top"
            style="background-image: url(/author/images/background.png)"
          >
            <dev class="tex_info">
              <span>Doctor neurologists in OHSU Hospital</span>
              <p>
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Et,
                volutpat feugiat placerat lobortis. Natoque rutrum semper sed
                suspendisse nunc lectus.
              </p>
              <button>HIRE ME -></button>
            </dev>
            <dev class="man_picture">
              <img src="/author/images/man.png" alt="" />
            </dev>
          </dev>
          <div class="mid_text">
            <span>My services</span>
            <p>
              Amet minim mollit non deserunt ullamco est sit aliqua dolor do
              amet sint. Velit officia consequat duis enim velit mollit. lorem
              ipsum
            </p>
          </div>
          <div class="mid_boxes">
            <div class="container">
              <div class="info_box">
                <img src="/author/images/coding.png" alt="" />
                <span>web development</span>
                <p>blog, e-commerce</p>
              </div>
              <div class="info_box">
                <img src="/author/images/illustration.png" alt="" />
                <span>uI/uX design</span>
                <p>Mobile app, website design</p>
              </div>
              <div class="info_box">
                <img src="/author/images/microphone.png" alt="" />
                <span>sound design</span>
                <p>Voice Over, Beat Making</p>
              </div>
              <div class="info_box">
                <img src="/author/images/game-development.png" alt="" />
                <span>game design</span>
                <p>Character Design, Props & Objects</p>
              </div>
              <div class="info_box">
                <img src="/author/images/Photographer.png" alt="" />
                <span>Character Design, Props & Objects</span>
                <p>portrait, product photography</p>
              </div>
              <div class="info_box">
                <span>advertising</span>
                <p>
                  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vitae
                  nulla diam in ac dictum a urna viverra morbi.
                </p>
                <span class="yellow_text">ORDER NOW ></span>
              </div>
            </div>
          </div>
        </div>
        <div class="right_frame">
          <a class="first_icon" href="">
            <img src="/author/menu_icon/right_top/Vector.png" alt="" />
          </a>
          <div class="container">
            <a class="second_icon" href="">
              <img src="/author/menu_icon/right_top/Home.png" alt="" />
            </a>
            <a class="rest_icon" href="">
              <img src="/author/menu_icon/right_top/file-code.png" alt="" />
            </a>
            <a class="rest_icon" href="">
              <img src="/author/menu_icon/right_top/cv.png" alt="" />
            </a>
            <a class="rest_icon" href="">
              <img src="/author/menu_icon/right_top/bag.png" alt="" />
            </a>
            <a class="rest_icon" href="">
              <img src="/author/menu_icon/right_top/Blog.png" alt="" />
            </a>
            <a class="rest_icon" href="">
              <img src="/author/menu_icon/right_top/Contact.png" alt="" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
